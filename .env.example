# Environment Variables for Playwright Tests

# Base URL for UI tests
BASE_URL=https://example.com

# Credentials for FakeStore login tests
FAKESTORE_USER=your_username@example.com
FAKESTORE_PASS=your_password

# Booker API base URL
BOOKER_API=https://restful-booker.herokuapp.com

# GitHub credentials for 2FA test
GH_USER=your_github_username
GH_PW=your_github_password
GH_OTP=your_totp_secret